    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.6.0-beta.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "allowScripts": {
    "@embedded-postgres/darwin-arm64@18.6.0-beta.19": true
  }
}
